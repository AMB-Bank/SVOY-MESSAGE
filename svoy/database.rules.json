{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
        ".validate": "newData.hasChildren(['username','displayName','createdAt'])",
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,20}$/)"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 600"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "privacy": {
          "showOnline": {
            ".validate": "newData.isBoolean()"
          },
          "showLastSeen": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid && !newData.exists()))",
        ".validate": "$name.matches(/^[a-z0-9_]{3,20}$/) && newData.isString()"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (data.exists() && data.child('createdBy').val() === auth.uid))",
        ".validate": "newData.hasChildren(['type','members','createdBy','createdAt'])",
        "type": {
          ".validate": "newData.val() === 'direct' || newData.val() === 'group'"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "createdBy": {
          ".validate": "newData.val() === auth.uid || data.val() === newData.val()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "members": {
          "$m": {
            ".write": "auth != null && $m === auth.uid && !newData.exists() && data.exists()",
            ".validate": "newData.val() === 'owner' || newData.val() === 'member'"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        "$msgId": {
          ".write": "auth != null && auth.token.email_verified === true && root.child('chats').child($chatId).child('members').child(auth.uid).exists() && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && data.child('from').val() === auth.uid))",
          ".validate": "newData.hasChildren(['from','ts']) && (newData.child('text').exists() || newData.child('attachment').exists())",
          "from": {
            ".validate": "newData.val() === auth.uid || data.val() === newData.val()"
          },
          "ts": {
            ".validate": "(!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val())"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length <= 4000"
          },
          "editedAt": {
            ".validate": "newData.isNumber()"
          },
          "attachment": {
            "url": {
              ".validate": "newData.isString() && newData.val().length < 1500 && newData.val().beginsWith('https://firebasestorage.googleapis.com/')"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "type": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "size": {
              ".validate": "newData.isNumber() && newData.val() <= 26214400"
            },
            "$other": {
              ".validate": false
            }
          },
          "reactions": {
            "$ruid": {
              ".write": "auth != null && $ruid === auth.uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
              ".validate": "newData.isString() && newData.val().length <= 8"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$chatId": {
          ".write": "auth != null && (auth.uid === $uid || (root.child('chats').child($chatId).child('members').child(auth.uid).exists() && root.child('chats').child($chatId).child('members').child($uid).exists()))",
          "lastMessage": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "lastTs": {
            ".validate": "newData.isNumber()"
          },
          "lastFrom": {
            ".validate": "newData.isString()"
          },
          "unread": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "reads": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('chats').child($chatId).child('members').child(auth.uid).exists()",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "connections": {
          "$conn": {
            ".validate": "newData.isNumber()"
          }
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "calls": {
      "$callId": {
        ".read": "auth != null && (data.child('caller').val() === auth.uid || data.child('callee').val() === auth.uid)",
        ".write": "auth != null && auth.token.email_verified === true && ((!data.exists() && newData.child('caller').val() === auth.uid && root.child('chats').child(newData.child('chatId').val()).child('members').child(auth.uid).exists() && root.child('chats').child(newData.child('chatId').val()).child('members').child(newData.child('callee').val()).exists()) || (data.exists() && (data.child('caller').val() === auth.uid || data.child('callee').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['caller','callee','chatId','type','status'])",
        "type": {
          ".validate": "newData.val() === 'audio' || newData.val() === 'video'"
        },
        "status": {
          ".validate": "newData.val() === 'ringing' || newData.val() === 'active' || newData.val() === 'ended' || newData.val() === 'declined' || newData.val() === 'missed'"
        }
      }
    },
    "incomingCalls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$callId": {
          ".write": "auth != null && (auth.uid === $uid || newData.child('from').val() === auth.uid || data.child('from').val() === auth.uid)",
          ".validate": "!newData.exists() || newData.hasChildren(['from','type'])"
        }
      }
    },
    "callLog": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}