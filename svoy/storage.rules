rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Аватары: читают авторизованные, пишет только владелец, только картинки до 2 МБ
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.auth.token.email_verified == true
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Вложения: путь содержит uid автора. ВАЖНО: правила Storage не могут проверить членство в чате
    // (нет доступа к Realtime Database), поэтому защита — авторизация + неугадываемое имя файла
    // + ограничения размера/типа. Ссылка в чате доступна только участникам (правила БД).
    match /attachments/{uid}/{chatId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType.matches('(image/(jpeg|png|webp|gif)|video/(mp4|webm)|audio/(mpeg|ogg|webm|mp4)|application/(pdf|zip)|text/plain)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
