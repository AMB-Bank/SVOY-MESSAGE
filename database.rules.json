{
  "rules": {
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','email'])"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('meta/members/'+auth.uid).exists()",
        ".write": "auth != null && ($chatId.contains(auth.uid))",
        "messages": {
          "$mid": {
            ".validate": "newData.child('from').val() === auth.uid"
          }
        }
      }
    }
  }
}
